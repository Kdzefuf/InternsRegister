@using InternsRegister.Application.DTOs

<table class="table table-zebra w-full">
    <thead>
        <tr>
            <th>Название</th>
            <th class="text-center">Стажёров</th>
            <th class="text-center">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Items)
        {
            <tr>
                <td class="font-medium">
                    @(item is DirectionDto d ? d.Name : (item is ProjectDto p ? p.Name : "—"))
                </td>
                <td class="text-center">
                    @(item is DirectionDto d2 ? d2.InternsCount : (item is ProjectDto p2 ? p2.InternsCount : 0))
                </td>
                <td class="text-center">
                    @{
                        var hasInterns = item is DirectionDto dir ? dir.InternsCount > 0
                        : (item is ProjectDto proj ? proj.InternsCount > 0 : false);
                    }
                    <button class="btn btn-ghost btn-xs text-error"
                            disabled="@hasInterns">
                        Удалить
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Пагинация -->
@if (TotalCount > PageSize)
{
    <div class="flex justify-between items-center mt-6">
        <div class="text-sm text-gray-600">
            Показано @(Math.Min((PageIndex * PageSize) + Items.Count(), TotalCount)) из @TotalCount
        </div>

        <div class="join">
            <button class="join-item btn"
                    @onclick="() => ChangePage(PageIndex - 1)"
                    disabled="@(PageIndex <= 0)">
                «
            </button>

            @for (int i = 0; i < TotalPages; i++)
            {
                var pageNum = i;
                <button class="join-item btn @(PageIndex == pageNum ? "btn-active" : "")"
                        @onclick="() => ChangePage(pageNum)">
                    @(pageNum + 1)
                </button>
            }

            <button class="join-item btn"
                    @onclick="() => ChangePage(PageIndex + 1)"
                    disabled="@(PageIndex >= TotalPages - 1)">
                »
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<object> Items { get; set; } = null!;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int PageIndex { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public string EntityType { get; set; } = "";

    private int TotalPages => (int)Math.Ceiling(TotalCount / (double)PageSize);

    private async Task ChangePage(int newPage)
    {
        if (newPage >= 0 && newPage < TotalPages)
        {
            await OnPageChanged.InvokeAsync(newPage);
        }
    }
}