@page "/directions"
@inject IDirectionService DirectionService
@inject IProjectService ProjectService
@inject IInternService InternService
@inject IJSRuntime JS
@using InternsRegister.Application.DTOs
@using System.Text.Json
@using InternsRegister.Application.Interfaces
@using InternsRegister.Web.Components.Modal
@rendermode InteractiveServer

<h2 class="text-3xl font-bold mb-8">Направления и проекты</h2>

<div class="tabs tabs-boxed mb-6">
    <a class="tab @(activeTab == "directions" ? "tab-active" : "")"
       @onclick="() => ChangeTab(directionsTab)">
        Направления (@(directions?.Items.Count ?? 0))
    </a>
    <a class="tab @(activeTab == "projects" ? "tab-active" : "")"
       @onclick="() => ChangeTab(projectsTab)">
        Проекты (@(projects?.Items.Count ?? 0))
    </a>
</div>

<div class="flex flex-col md:flex-row gap-4 mb-6">
    <input type="text" placeholder="Поиск по названию..."
           class="input input-bordered flex-1 max-w-md"
           @bind="searchQuery" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />

    <select @bind="sortBy" class="select select-bordered w-full md:w-48">
        <option value="name">По названию</option>
        <option value="internscount">По кол-ву стажёров</option>
    </select>

    <button @onclick="ToggleSortOrder" class="btn">
        @(ascending ? "По возрастанию" : "По убыванию")
    </button>
</div>

@if (isLoading)
{
    <div class="flex justify-center py-12">
        <span class="loading loading-spinner loading-lg"></span>
    </div>
}
else if (activeTab == "directions" && directions?.Items.Any() == true)
{
    <div class="overflow-x-auto">
        <table class="table table-zebra w-full">
            <thead>
                <tr>
                    <th></th>
                    <th>Название направления</th>
                    <th>Стажёров</th>
                    <th>Создано</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dir in directions.Items)
                {
                    var isOpen = expandedId == dir.Id;
                    <tr class="@(isOpen ? "bg-base-200" : "hover") cursor-pointer"
                        @onclick="() => ToggleExpand(dir.Id)">
                        <td>
                            <span class="text-xl">@(isOpen ? "↓" : "→")</span>
                        </td>
                        <td class="font-medium">@dir.Name</td>
                        <td>@dir.InternsCount</td>
                        <td>@dir.CreatedAt:dd.MM.yyyy</td>
                        <td class="flex gap-2">
                            <button class="btn btn-ghost btn-xs" @onclick:stopPropagation @onclick="() => OpenEdit(dir.Id, dir.Name, true)">
                                Изменить
                            </button>
                            <button class="btn btn-ghost btn-xs text-error" @onclick:stopPropagation @onclick="() => OpenDelete(dir.Id, dir.Name, true)">
                                Удалить
                            </button>
                        </td>
                    </tr>

                    @if (isOpen)
                    {
                        <tr>
                            <td colspan="5" class="p-0">
                                <div class="bg-base-100 p-4">
                                    <InternsList DirectionId="@dir.Id" ProjectId="@null" />
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
else if (activeTab == "projects" && projects?.Items.Any() == true)
{
    <div class="overflow-x-auto">
        <table class="table table-zebra w-full">
            <thead>
                <tr>
                    <th></th>
                    <th>Название проекта</th>
                    <th>Стажёров</th>
                    <th>Создано</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proj in projects.Items)
                {
                    var isOpen = expandedId == proj.Id;
                    <tr class="@(isOpen ? "bg-base-200" : "hover") cursor-pointer"
                        @onclick="() => ToggleExpand(proj.Id)">
                        <td>
                            <span class="text-xl">@(isOpen ? "↓" : "→")</span>
                        </td>
                        <td class="font-medium">@proj.Name</td>
                        <td>@proj.InternsCount</td>
                        <td>@proj.CreatedAt:dd.MM.yyyy</td>
                        <td class="flex gap-2">
                            <button class="btn btn-ghost btn-xs" @onclick:stopPropagation @onclick="() => OpenEdit(proj.Id, proj.Name, false)">
                                Изменить
                            </button>
                            <button class="btn btn-ghost btn-xs text-error" @onclick:stopPropagation @onclick="() => OpenDelete(proj.Id, proj.Name, false)">
                                Удалить
                            </button>
                        </td>
                    </tr>

                    @if (isOpen)
                    {
                        <tr>
                            <td colspan="5" class="p-0">
                                <div class="bg-base-100 p-4">
                                    <InternsList DirectionId="@null" ProjectId="@proj.Id" />
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@if ((activeTab == "directions" ? directions?.TotalCount : projects?.TotalCount) > pageSize)
{
    <div class="flex justify-center mt-6">
        <div class="join">
            @for (int i = 0; i < (int)Math.Ceiling(((activeTab == "directions" ? directions?.TotalCount : projects?.TotalCount) ?? 0) / (double)pageSize); i++)
            {
                var pageNum = i;
                <button class="join-item btn @(pageIndex == pageNum ? "btn-active" : "")"
                        @onclick="() => OnPageChanged(pageNum)">
                    @(pageNum + 1)
                </button>
            }
        </div>
    </div>
}

<EditDirectionOrProjectModal @ref="editModalRef"
                             ModalId="@editModalId"
                             OnClose="() => editModalId = null"
                             OnSaved="LoadData" />

<ConfirmDeleteModal ModalId="@deleteModalId"
                    EntityName="@entityToDeleteName"
                    OnConfirm="ConfirmDelete"
                    OnCancel="() => { deleteModalId = null; entityToDeleteId = Guid.Empty; }" />

@code {
    private string activeTab = "directions";
    private string directionsTab = "directions";
    private string projectsTab = "projects";
    private string searchQuery = "";
    private string sortBy = "name";
    private bool ascending = true;
    private int pageIndex = 0;
    private const int pageSize = 10;
    private bool isLoading = false;
    private bool isClient = false;

    private Guid? expandedId;
    private string? editModalId;
    private string? deleteModalId;
    private Guid entityToDeleteId;
    private string entityToDeleteName = "";
    private bool entityIsDirection;

    private PaginatedList<DirectionDto> directions = new([], 0, 0, 10);
    private PaginatedList<ProjectDto> projects = new([], 0, 0, 10);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isClient = true;
            await LoadStateFromLocalStorage();
            await LoadData();
        }
    }

    private void ToggleExpand(Guid id)
    {
        expandedId = expandedId == id ? null : id;
    }

    private async Task OpenEdit(Guid id, string name, bool isDirection)
    {
        editModalId = "edit-modal";

        var currentInternIds = isDirection
            ? (await InternService.GetAllAsync()).Where(i => i.Direction == name).Select(i => i.Id).ToList()
            : (await InternService.GetAllAsync()).Where(i => i.Project == name).Select(i => i.Id).ToList();

        if (isDirection)
            editModalRef?.OpenDirection(id, name, currentInternIds);
        else
            editModalRef?.OpenProject(id, name, currentInternIds);
    }

    private void OpenDelete(Guid id, string name, bool isDirection)
    {
        entityToDeleteId = id;
        entityToDeleteName = name;
        entityIsDirection = isDirection;
        deleteModalId = "delete-modal";
    }

    private async Task ConfirmDelete()
    {
        try
        {
            if (entityIsDirection)
                await DirectionService.DeleteAsync(entityToDeleteId);
            else
                await ProjectService.DeleteAsync(entityToDeleteId);

            await LoadData();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            deleteModalId = null;
            entityToDeleteId = Guid.Empty;
        }
    }

    private EditDirectionOrProjectModal? editModalRef;

    private async Task LoadData()
    {
        if (!isClient && !OperatingSystem.IsBrowser()) return;

        isLoading = true;
        StateHasChanged();

        try
        {
            if (activeTab == "directions")
            {
                directions = await DirectionService.GetPagedAsync(
                    pageIndex, pageSize, searchQuery.Trim(), sortBy, ascending);
            }
            else
            {
                projects = await ProjectService.GetPagedAsync(
                    pageIndex, pageSize, searchQuery.Trim(), sortBy, ascending);
            }
        }
        finally
        {
            isLoading = false;
            if (isClient)
                await SaveStateToLocalStorage();
            StateHasChanged();
        }
    }

    private async Task SaveStateToLocalStorage()
    {
        if (!isClient) return;

        var state = new { activeTab, searchQuery, sortBy, ascending, pageIndex };
        var json = JsonSerializer.Serialize(state);
        await JS.InvokeVoidAsync("localStorage.setItem", "directionsProjectsState", json);
    }

    private async Task LoadStateFromLocalStorage()
    {
        if (!isClient) return;
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", "directionsProjectsState");
            if (!string.IsNullOrEmpty(json))
            {
                var state = JsonSerializer.Deserialize<JsonElement>(json);
                activeTab = state.GetProperty("activeTab").GetString() ?? "directions";
                searchQuery = state.TryGetProperty("searchQuery", out var sq) ? sq.GetString() ?? "" : "";
                sortBy = state.TryGetProperty("sortBy", out var sb) ? sb.GetString() ?? "name" : "name";
                ascending = state.TryGetProperty("ascending", out var asc) ? asc.GetBoolean() : true;
                pageIndex = state.TryGetProperty("pageIndex", out var pi) ? pi.GetInt32() : 0;
            }
        }
        catch
        {
            throw new ArgumentNullException();   
        }
    }

    private async Task ChangeTab(string tab)
    {
        if (activeTab != tab)
        {
            activeTab = tab;
            pageIndex = 0;
            searchQuery = "";
            await LoadData();
        }
    }

    private async Task ToggleSortOrder()
    {
        ascending = !ascending;
        pageIndex = 0;
        await LoadData();
    }

    private async Task OnPageChanged(int newPage)
    {
        if (pageIndex != newPage)
        {
            pageIndex = newPage;
            await LoadData();
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            pageIndex = 0;
            await LoadData();
        }
    }
}